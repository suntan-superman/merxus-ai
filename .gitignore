# This repository publishes the ready-to-serve site files from its root.
# Keep local settings and credentials out of both Git and the publish folder.
.env
.env.*
*.env
*.env.*
*.local
.npmrc
.yarnrc
.yarnrc.yml
.pypirc
*.secret
*.secret.*

# Private keys, account credentials, and mobile signing files.
**/serviceAccountKey.json
**/*-firebase-adminsdk-*.json
**/*service-account*.json
**/*credentials*.json
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

